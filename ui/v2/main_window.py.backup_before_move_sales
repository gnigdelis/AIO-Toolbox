def resource_path(path: Path) -> str:
    """
    Return an application resource path.

    Works both when running from source and
    when packaged with PyInstaller.
    """
    import os
    import sys

    if hasattr(sys, "_MEIPASS"):
        base_path = Path(sys._MEIPASS)
    else:
        base_path = Path.cwd()

    return os.path.join(
        str(base_path),
        str(path),
    )


class ImpactStatusWorker(QThread):
    """
    Background worker for checking Impact / myDATA availability.
    """

    status_changed = Signal(bool)

    def run(self) -> None:
        try:
            request = urllib.request.Request(
                IMPACT_STATUS_URL,
                method="GET",
                headers={
                    "Accept": "application/json",
                    "User-Agent": "AIO-Toolbox",
                },
            )

            with urllib.request.urlopen(
                request,
                timeout=5,
            ) as response:
                payload = json.loads(
                    response.read().decode("utf-8")
                )

            self.status_changed.emit(
                payload.get("success") is True
            )

        except Exception:
            self.status_changed.emit(False)


