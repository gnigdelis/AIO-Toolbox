    # ================================================================
    # Impact status
    # ================================================================

    def _start_impact_monitor(
        self,
    ) -> None:
        self._impact_worker = None

        self._impact_timer = QTimer(
            self
        )
        self._impact_timer.timeout.connect(
            self._check_impact_status
        )
        self._impact_timer.start(
            30000
        )

        QTimer.singleShot(
            250,
            self._check_impact_status,
        )

    def _check_impact_status(
        self,
    ) -> None:
        if (
            self._impact_worker is not None
            and self._impact_worker.isRunning()
        ):
            return

        self.impact_status_button.setText(
            "●  Checking Impact..."
        )
        self.impact_status_button.setStyleSheet(
            """
            QPushButton#impactStatusButton {
                min-height: 38px;
                padding: 0 10px;
                background: #F7F9FC;
                color: #526176;
                border: 1px solid #D9E2EF;
                border-radius: 7px;
                font-weight: 600;
            }
            """
        )

        self._impact_worker = ImpactStatusWorker(
            self
        )
        self._impact_worker.status_changed.connect(
            self._set_impact_status
        )
        self._impact_worker.finished.connect(
            self._impact_worker_finished
        )
        self._impact_worker.start()

    def _set_impact_status(
        self,
        online: bool,
    ) -> None:
        if online:
            self.impact_status_button.setText(
                "●  Impact Online"
