    def _connect_database_context(
        self,
    ) -> None:
        database_context.database_changed.connect(
            self._database_changed
        )

        current = (
            database_context.active()
        )

        if current:
            self._database_changed(
                current
            )
        else:
            self._set_database_disconnected()

    def _open_database_selector(self) -> None:
        dialog = DatabaseSelector(self)

        if dialog.exec() != QDialog.DialogCode.Accepted:
            return

        selected_udl = dialog.selected_udl

        if not selected_udl:
            QMessageBox.warning(
                self,
                "Database",
                "No database connection was selected.",
            )
            return

        try:
            database = database_context.select(
                selected_udl
            )

            self._database_changed(
                database
            )

        except Exception as exc:
            QMessageBox.critical(
                self,
                "Database Connection",
                f"Could not activate the selected database.\n\nError:\n{exc}",
            )

    def _database_changed(
        self,
        database: dict | None,
    ) -> None:
        if not database:
            self._set_database_disconnected()
            return

        database_name = (
            database.get("name")
            or "Unknown"
        )

        self._set_database_button_state(
            True,
            database_name,
        )

        self.database_button.setToolTip(
            database.get(
                "path",
                "",
            )
        )

    def _set_database_button_state(
