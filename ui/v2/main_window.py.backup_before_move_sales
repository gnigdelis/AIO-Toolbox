            )
            self.impact_status_button.setStyleSheet(
                """
                QPushButton#impactStatusButton {
                    min-height: 38px;
                    padding: 0 12px;
                    background: #FFF1F1;
                    color: #D32F2F;
                    border: 1px solid #F1B7B7;
                    border-radius: 7px;
                    font-weight: 600;
                }
                QPushButton#impactStatusButton:hover {
