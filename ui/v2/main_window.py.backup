APP_ICON_PATH = "assets/branding/window/app.ico"


def resource_path(relative_path: str) -> str:
    try:
        base_path = sys._MEIPASS  # type: ignore[attr-defined]
    except Exception:
        base_path = os.path.abspath(".")

    return os.path.join(
        base_path,
        relative_path,
    )


class MainWindow(QMainWindow):
    WINDOW_MIN_WIDTH = 1024
    WINDOW_MIN_HEIGHT = 768

    WINDOW_DEFAULT_WIDTH = 1565
    WINDOW_DEFAULT_HEIGHT = 990

    HEADER_HEIGHT = 112
    STATUSBAR_HEIGHT = 46

    SIDEBAR_NORMAL_WIDTH = 295
    SIDEBAR_COMPACT_WIDTH = 250

    def __init__(self) -> None:
        super().__init__()

        self._navigation_buttons: list[QPushButton] = []

        self._setup_window()
        self._build_ui()

        # Maximize only after the UI has been built.
        # resizeEvent() depends on widgets such as self._sidebar.
        self.showMaximized()

        self._connect_database_context()
        self._start_clock()

    # ================================================================
    # WINDOW
    # ================================================================

    def _setup_window(self) -> None:
        self.setWindowTitle(
            "AIO Toolbox"
        )

        app_icon = QIcon(
            resource_path(
                APP_ICON_PATH
            )
        )

        if not app_icon.isNull():
            self.setWindowIcon(
                app_icon
            )

        self.setMinimumSize(
            self.WINDOW_MIN_WIDTH,
            self.WINDOW_MIN_HEIGHT,
        )

        self.resize(
            self.WINDOW_DEFAULT_WIDTH,
            self.WINDOW_DEFAULT_HEIGHT,
        )

    # ================================================================
    # MAIN UI
    # ================================================================

    def _build_ui(self) -> None:
        root = QWidget()
        root.setObjectName(
            "root"
        )

        root.setMinimumSize(
            0,
            0,
        )

        root_layout = QVBoxLayout(
            root
        )

        root_layout.setContentsMargins(
            0,
            0,
            0,
            0,
        )

        root_layout.setSpacing(
            0
        )

        root_layout.addWidget(
            self._create_header()
        )

        body = QWidget()
        body.setObjectName(
            "mainBody"
        )

        body.setMinimumSize(
            0,
            0,
        )

        body_layout = QHBoxLayout(
            body
        )

        body_layout.setContentsMargins(
            0,
            0,
            0,
            0,
        )

        body_layout.setSpacing(
            0
        )

        self._sidebar = self._create_sidebar()

        body_layout.addWidget(
            self._sidebar,
            0,
        )

        content = self._create_content_area()

        content.setSizePolicy(
            QSizePolicy.Policy.Expanding,
            QSizePolicy.Policy.Expanding,
        )

        content.setMinimumWidth(
            0
        )

        body_layout.addWidget(
            content,
            1,
        )

        root_layout.addWidget(
            body,
            1,
        )

        root_layout.addWidget(
            self._create_status_bar()
        )

        self.setCentralWidget(
            root
        )

