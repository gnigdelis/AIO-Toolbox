        button.setObjectName(
            "headerButton"
        )

        button.setFixedSize(
            46,
            46,
        )

        button.setCursor(
            Qt.CursorShape.PointingHandCursor
        )

        button.setIcon(
            icon(
                icon_name,
                "#40506A",
                22,
            )
        )

        button.setIconSize(
            QSize(
                27,
