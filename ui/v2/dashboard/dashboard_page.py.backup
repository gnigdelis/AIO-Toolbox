    # ==========================================================
    # INFO ROW
    # ==========================================================

    def _info_row(
        self,
        label_text: str,
        value_text: str,
    ) -> QWidget:
        row = QWidget()

        row.setMinimumWidth(
            0
        )

        row.setMinimumHeight(
            28
        )

        row_layout = QHBoxLayout(
            row
        )

        row_layout.setContentsMargins(
            0,
            0,
            0,
            0,
        )

        row_layout.setSpacing(
            10
        )

        label = QLabel(
            label_text
        )

        label.setObjectName(
            "infoLabel"
        )

        label.setFixedWidth(
            125
        )

        value = QLabel(
            value_text
        )

        value.setObjectName(
            "infoValue"
        )

        value.setTextInteractionFlags(
            Qt.TextInteractionFlag.TextSelectableByMouse
        )

        value.setWordWrap(
            True
        )

        value.setMinimumWidth(
            0
        )

        row_layout.addWidget(
            label,
            0,
        )

        row_layout.addWidget(
            value,
            1,
        )

        return row

    # ==========================================================
    # ACTIVITY ROW
    # ==========================================================

    def _activity_row(
        self,
