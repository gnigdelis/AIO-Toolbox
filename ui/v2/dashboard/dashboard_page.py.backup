    # ==========================================================
    # SYSTEM OVERVIEW
    # ==========================================================

    def _create_system_overview(self) -> QFrame:
        panel = QFrame()

        panel.setObjectName(
            "dashboardCard"
        )

        panel.setMinimumSize(
            0,
            270,
        )

        panel.setMaximumHeight(
            270
        )

        panel.setSizePolicy(
            QSizePolicy.Policy.Expanding,
            QSizePolicy.Policy.Fixed,
        )

        layout = QVBoxLayout(
            panel
        )

        layout.setContentsMargins(
            22,
            18,
            22,
            18,
        )

        layout.setSpacing(
            10
        )

        # ------------------------------------------------------
        # Header
        # ------------------------------------------------------

        header = QHBoxLayout()

        icon_label = QLabel(
            "▣"
        )

        icon_label.setObjectName(
            "panelIcon"
        )

        icon_label.setFixedWidth(
            22
        )

        title = QLabel(
            "System Overview"
        )

        title.setObjectName(
            "panelTitle"
        )

        header.addWidget(
            icon_label
        )

        header.addWidget(
            title
        )

        header.addStretch()

        status = QLabel(
            "Live system information"
        )

        status.setObjectName(
            "liveStatus"
        )

        header.addWidget(
            status
        )

        layout.addLayout(
            header
        )

        # ------------------------------------------------------
        # Separator
        # ------------------------------------------------------

        separator = QFrame()

        separator.setFrameShape(
            QFrame.Shape.HLine
        )

        separator.setObjectName(
            "panelSeparator"
        )

        separator.setFixedHeight(
            1
        )

        layout.addWidget(
            separator
        )

        # ------------------------------------------------------
        # Real system information
        # ------------------------------------------------------

        system_info = (
            self._get_system_information()
        )

        for (
            label_text,
            value_text,
        ) in system_info:
            layout.addWidget(
                self._info_row(
                    label_text,
                    value_text,
                )
            )

        layout.addStretch()

        return panel

    # ==========================================================
    # REAL SYSTEM INFORMATION
    # ==========================================================

    def _get_system_information(
        self,
    ) -> list[tuple[str, str]]:
        return [
            (
                "Computer Name",
                self._computer_name(),
            ),
            (
                "Operating System",
                self._operating_system(),
            ),
            (
                "User",
                self._current_user(),
            ),
            (
                "CPU",
                self._processor(),
            ),
            (
                "Memory",
                self._memory(),
            ),
            (
                "System Drive",
                self._system_drive(),
            ),
            (
                "Uptime",
                self._uptime(),
            ),
        ]

    # ==========================================================
    # COMPUTER NAME
    # ==========================================================

    def _computer_name(self) -> str:
        try:
            return socket.gethostname()
        except OSError:
            return "Unknown"

    # ==========================================================
    # OPERATING SYSTEM
    # ==========================================================

    def _operating_system(self) -> str:
        try:
            system = platform.system()
            release = platform.release()
            version = platform.version()

            if system == "Windows":
                windows_name = self._windows_name()

                if windows_name:
                    return (
                        f"{windows_name} "
                        f"({release})"
                    )

                return (
                    f"Windows {release} "
                    f"({version})"
                )

            return f"{system} {release}"

        except Exception:
            return "Unknown"

    def _windows_name(self) -> str:
        try:
            import winreg

            key_path = (
                r"SOFTWARE\Microsoft\Windows NT"
                r"\CurrentVersion"
            )

            with winreg.OpenKey(
                winreg.HKEY_LOCAL_MACHINE,
                key_path,
            ) as key:
                product_name = (
                    winreg.QueryValueEx(
                        key,
                        "ProductName",
                    )[0]
                )

            return str(
                product_name
            )

        except Exception:
            return ""

    # ==========================================================
    # CURRENT USER
    # ==========================================================

    def _current_user(self) -> str:
        try:
            return getpass.getuser()
        except Exception:
            return os.environ.get(
                "USERNAME",
                "Unknown",
            )

    # ==========================================================
    # PROCESSOR
    # ==========================================================

    def _processor(self) -> str:
        try:
            processor = (
                platform.processor()
            )

            if processor:
                return processor

            machine = (
                platform.machine()
            )

            if machine:
                return machine

            return (
                f"{os.cpu_count() or 1} "
                "logical processors"
            )

        except Exception:
            return "Unknown"

    # ==========================================================
    # MEMORY
    # ==========================================================

    def _memory(self) -> str:
        try:
            class MEMORYSTATUSEX(
                ctypes.Structure
            ):
                _fields_ = [
                    (
                        "dwLength",
                        ctypes.c_ulong,
                    ),
                    (
                        "dwMemoryLoad",
                        ctypes.c_ulong,
                    ),
                    (
                        "ullTotalPhys",
                        ctypes.c_ulonglong,
                    ),
                    (
                        "ullAvailPhys",
                        ctypes.c_ulonglong,
                    ),
                    (
                        "ullTotalPageFile",
                        ctypes.c_ulonglong,
                    ),
                    (
                        "ullAvailPageFile",
                        ctypes.c_ulonglong,
                    ),
                    (
                        "ullTotalVirtual",
                        ctypes.c_ulonglong,
                    ),
                    (
                        "ullAvailVirtual",
                        ctypes.c_ulonglong,
                    ),
                    (
                        "sullAvailExtendedVirtual",
                        ctypes.c_ulonglong,
                    ),
                ]

            memory_status = (
                MEMORYSTATUSEX()
            )

            memory_status.dwLength = (
                ctypes.sizeof(
                    MEMORYSTATUSEX
                )
            )

            result = (
                ctypes.windll.kernel32
                .GlobalMemoryStatusEx(
                    ctypes.byref(
                        memory_status
                    )
                )
            )

            if not result:
                return "Unknown"

            total_gb = (
                memory_status.ullTotalPhys
                / (
                    1024
                    * 1024
                    * 1024
                )
            )

            used_percent = (
                memory_status.dwMemoryLoad
            )

            return (
                f"{total_gb:.1f} GB total "
                f"({used_percent}% used)"
            )

        except Exception:
            return "Unknown"

    # ==========================================================
    # SYSTEM DRIVE
    # ==========================================================

    def _system_drive(self) -> str:
        try:
            system_drive = (
                os.environ.get(
                    "SystemDrive",
                    "C:",
                )
                + "\\"
            )

            total, used, free = (
                shutil.disk_usage(
                    system_drive
                )
            )

            total_gb = (
                total
                / (
                    1024
                    * 1024
                    * 1024
                )
            )

            free_gb = (
                free
                / (
                    1024
                    * 1024
                    * 1024
                )
            )

            used_percent = (
                used
                / total
                * 100
                if total
                else 0
            )

            return (
                f"{system_drive}  •  "
                f"{free_gb:.1f} GB free of "
                f"{total_gb:.1f} GB "
                f"({used_percent:.0f}% used)"
            )

        except Exception:
            return "Unknown"

    # ==========================================================
    # UPTIME
    # ==========================================================

    def _uptime(self) -> str:
        try:
            if platform.system() == "Windows":
                milliseconds = (
                    ctypes.windll.kernel32
                    .GetTickCount64()
                )

                total_seconds = (
                    milliseconds / 1000
                )

                return self._format_uptime(
                    total_seconds
                )

            return "Unavailable"

        except Exception:
            return "Unknown"

    @staticmethod
    def _format_uptime(
        total_seconds: float,
    ) -> str:
        seconds = int(
            total_seconds
        )

        days, remainder = divmod(
            seconds,
            86400,
        )

        hours, remainder = divmod(
            remainder,
            3600,
        )

        minutes, _ = divmod(
            remainder,
            60,
        )

        if days:
            return (
                f"{days} day"
                f"{'s' if days != 1 else ''}, "
                f"{hours} hour"
                f"{'s' if hours != 1 else ''}, "
                f"{minutes} min"
            )

        if hours:
            return (
                f"{hours} hour"
                f"{'s' if hours != 1 else ''}, "
                f"{minutes} min"
            )

        return (
            f"{minutes} min"
        )

