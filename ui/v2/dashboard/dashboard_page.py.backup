from __future__ import annotations

import ctypes
import getpass
import os
import platform
import shutil
import socket
from collections.abc import Callable

from PySide6.QtCore import Qt
from PySide6.QtWidgets import (
    QFrame,
    QHBoxLayout,
    QLabel,
    QScrollArea,
    QSizePolicy,
    QVBoxLayout,
    QWidget,
)


class DashboardPage(QWidget):
    """Main AIO Toolbox dashboard."""

    def __init__(
        self,
        on_navigate: Callable[[str], None] | None = None,
        parent: QWidget | None = None,
    ) -> None:
        super().__init__(parent)

        self.on_navigate = on_navigate

        self.setObjectName(
            "dashboardPage"
        )

        self.setMinimumSize(
            0,
            0,
        )

        self.setSizePolicy(
            QSizePolicy.Policy.Expanding,
            QSizePolicy.Policy.Expanding,
        )

        self._build_ui()

    # ==========================================================
    # MAIN UI
    # ==========================================================

    def _build_ui(self) -> None:
        outer_layout = QVBoxLayout(
            self
        )

        outer_layout.setContentsMargins(
            0,
            0,
            0,
            0,
        )

        outer_layout.setSpacing(
            0
        )

        scroll = QScrollArea()

        scroll.setObjectName(
            "dashboardScroll"
        )

        scroll.setWidgetResizable(
            True
        )

        scroll.setFrameShape(
            QFrame.Shape.NoFrame
        )

        scroll.setHorizontalScrollBarPolicy(
            Qt.ScrollBarPolicy.ScrollBarAlwaysOff
        )

        scroll.setVerticalScrollBarPolicy(
            Qt.ScrollBarPolicy.ScrollBarAsNeeded
        )

        scroll.setAlignment(
            Qt.AlignmentFlag.AlignTop
            | Qt.AlignmentFlag.AlignLeft
        )

        scroll.setMinimumSize(
            0,
            0,
        )

        scroll.setSizePolicy(
            QSizePolicy.Policy.Expanding,
            QSizePolicy.Policy.Expanding,
        )

        # ------------------------------------------------------
        # CONTENT
        # ------------------------------------------------------

        content = QWidget()

        content.setObjectName(
            "dashboardContent"
        )

        content.setMinimumSize(
            0,
            0,
        )

        content.setSizePolicy(
            QSizePolicy.Policy.Expanding,
            QSizePolicy.Policy.Preferred,
        )

        content_layout = QVBoxLayout(
            content
        )

        content_layout.setContentsMargins(
            28,
            24,
            28,
            28,
        )

        content_layout.setSpacing(
            20
        )

        # ------------------------------------------------------
        # Welcome
        # ------------------------------------------------------

        welcome = self._create_welcome_panel()

        welcome.setMinimumWidth(
            0
        )

        welcome.setSizePolicy(
            QSizePolicy.Policy.Expanding,
            QSizePolicy.Policy.Fixed,
        )

        content_layout.addWidget(
            welcome
        )

        # ------------------------------------------------------
        # System Overview
        # ------------------------------------------------------

        system_overview = (
            self._create_system_overview()
        )

        system_overview.setMinimumWidth(
            0
        )

        system_overview.setSizePolicy(
            QSizePolicy.Policy.Expanding,
            QSizePolicy.Policy.Fixed,
        )

        content_layout.addWidget(
            system_overview
        )

        # ------------------------------------------------------
        # Recent Activity
        # ------------------------------------------------------

        recent_activity = (
            self._create_recent_activity()
        )

        recent_activity.setMinimumWidth(
            0
        )

        recent_activity.setSizePolicy(
            QSizePolicy.Policy.Expanding,
            QSizePolicy.Policy.Fixed,
        )

        content_layout.addWidget(
            recent_activity
        )

        content_layout.addStretch(
            1
        )

        scroll.setWidget(
            content
        )

        outer_layout.addWidget(
            scroll,
            1,
        )

        self._apply_dashboard_style()

