    def _refresh_move_sales_summary(self) -> None:
        if not hasattr(
            self,
            "move_sales_button",
        ):
            return

        from datetime import date

        today = date.today()

        self.move_sales_today_label.setText(
            "\u03a3\u03b7\u03bc\u03b5\u03c1\u03b9\u03bd\u03ae "
            "\u03b7\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1: "
            f"{today.strftime('%d/%m/%Y')}"
        )

        if not database_context.is_selected():
            self._sales_oldest_date = None
            self._sales_latest_date = None
            self._sales_active_count = 0

            self.move_sales_latest_label.setText(
                "\u03a4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 "
                "\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf SalesTrans: -"
            )

            self.move_sales_oldest_label.setText(
                "\u03a0\u03b1\u03bb\u03b1\u03b9\u03cc\u03c4\u03b5\u03c1\u03b7 "
                "\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf SalesTrans: -"
            )

            self.move_sales_button.setEnabled(False)
            self.move_sales_from_date_edit.setEnabled(False)
            self.move_sales_until_date_edit.setEnabled(False)

            return

        try:
            summary = (
                self.service
                .get_active_sales_summary()
            )

            self._sales_active_count = int(
                summary.get("count", 0) or 0
            )

            self._sales_oldest_date = (
                summary.get("oldest_date")
            )

            self._sales_latest_date = (
                summary.get("latest_date")
            )

            self.move_sales_latest_label.setText(
                "\u03a4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 "
                "\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf SalesTrans: "
                + (
                    self._sales_latest_date.strftime(
                        "%d/%m/%Y"
                    )
                    if self._sales_latest_date
                    else "-"
                )
            )

            self.move_sales_oldest_label.setText(
                "\u03a0\u03b1\u03bb\u03b1\u03b9\u03cc\u03c4\u03b5\u03c1\u03b7 "
                "\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf SalesTrans: "
                + (
                    self._sales_oldest_date.strftime(
                        "%d/%m/%Y"
                    )
                    if self._sales_oldest_date
                    else "-"
                )
            )

            if not self._sales_oldest_date:
                self.move_sales_button.setEnabled(False)
                self.move_sales_from_date_edit.setEnabled(False)
                self.move_sales_until_date_edit.setEnabled(False)
                return

            oldest_qdate = QDate(
                self._sales_oldest_date.year,
                self._sales_oldest_date.month,
                self._sales_oldest_date.day,
            )

            latest_qdate = (
                QDate(
                    self._sales_latest_date.year,
                    self._sales_latest_date.month,
                    self._sales_latest_date.day,
                )
                if self._sales_latest_date
                else oldest_qdate
            )

            self.move_sales_from_date_edit.setMinimumDate(
                oldest_qdate
            )

            self.move_sales_from_date_edit.setMaximumDate(
                latest_qdate
            )

            self.move_sales_from_date_edit.blockSignals(
                True
            )

            self.move_sales_from_date_edit.setDate(
                oldest_qdate
            )

            self.move_sales_from_date_edit.blockSignals(
                False
            )

            proposed = self._add_sales_months(
                self._sales_oldest_date,
                1,
            )

            if (
                self._sales_latest_date
                and proposed > self._sales_latest_date
            ):
                proposed = self._sales_latest_date

            proposed_qdate = QDate(
                proposed.year,
                proposed.month,
                proposed.day,
            )

            self.move_sales_until_date_edit.setMinimumDate(
                oldest_qdate
            )

            self.move_sales_until_date_edit.setMaximumDate(
                latest_qdate
            )

            self.move_sales_until_date_edit.blockSignals(
                True
            )

            self.move_sales_until_date_edit.setDate(
                proposed_qdate
            )

            self.move_sales_until_date_edit.blockSignals(
                False
            )

            self.move_sales_button.setEnabled(True)
            self.move_sales_from_date_edit.setEnabled(True)
            self.move_sales_until_date_edit.setEnabled(True)

        except Exception as exc:
            self.move_sales_latest_label.setText(
                "\u03a4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 "
                "\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf SalesTrans: Error"
            )

            self.move_sales_oldest_label.setText(
                "\u03a0\u03b1\u03bb\u03b1\u03b9\u03cc\u03c4\u03b5\u03c1\u03b7 "
                "\u03ba\u03af\u03bd\u03b7\u03c3\u03b7 \u03c3\u03c4\u03bf SalesTrans: Error"
            )

            self.move_sales_button.setEnabled(False)
            self.move_sales_from_date_edit.setEnabled(False)
            self.move_sales_until_date_edit.setEnabled(False)

            self.log_label.setText(
                "Move Sales To Hist summary error:\n"
                f"{exc}"
            )

    @staticmethod
    def _add_sales_months(
        source,
        months: int,
    ):
        import calendar
        from datetime import date

        month = (
            source.month
            - 1
            + months
        )

        year = (
            source.year
            + month // 12
        )

        month = (
            month % 12
            + 1
        )

        day = min(
            source.day,
            calendar.monthrange(
                year,
                month,
            )[1],
        )

        return date(
            year,
            month,
            day,
        )

    def _move_sales_date_changed(
        self,
        qdate: QDate,
    ) -> None:
        if not self._sales_oldest_date:
            return

        from datetime import date

        selected = date(
            qdate.year(),
            qdate.month(),
            qdate.day(),
        )

        if selected < self._sales_oldest_date:
            self.move_sales_until_date_edit.blockSignals(
                True
            )

            self.move_sales_until_date_edit.setDate(
                QDate(
                    self._sales_oldest_date.year,
                    self._sales_oldest_date.month,
                    self._sales_oldest_date.day,
                )
            )

            self.move_sales_until_date_edit.blockSignals(
                False
            )

            return

        if (
            self._sales_latest_date
            and selected > self._sales_latest_date
        ):
            self.move_sales_until_date_edit.blockSignals(
                True
            )

            self.move_sales_until_date_edit.setDate(
                QDate(
                    self._sales_latest_date.year,
                    self._sales_latest_date.month,
                    self._sales_latest_date.day,
                )
            )

            self.move_sales_until_date_edit.blockSignals(
                False
            )

