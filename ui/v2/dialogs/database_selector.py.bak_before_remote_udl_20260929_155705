    # ============================================================
    # LOCAL UDL LIST
    # ============================================================

    def _load_udls(self) -> None:
        self.udl_list.clear()

        udls = UDLLocator.find_all()

        last_udl = str(
            self._settings.value(
                self.LAST_UDL_KEY,
                "",
            )
            or ""
        )

        last_udl_path = (
            Path(last_udl).resolve()
            if last_udl
            else None
        )

        selected_row = -1

        for index, udl in enumerate(udls):
            item = QListWidgetItem(
                udl.name
            )

            item.setData(
                Qt.ItemDataRole.UserRole,
                str(udl),
            )

            item.setToolTip(
                str(udl)
            )

            self.udl_list.addItem(
                item
            )

            try:
                if (
                    last_udl_path
                    and udl.resolve()
                    == last_udl_path
                ):
                    selected_row = index
            except (
                OSError,
                RuntimeError,
            ):
                pass

        if selected_row >= 0:
            self.udl_list.setCurrentRow(
                selected_row
            )

        elif self.udl_list.count() == 1:
            self.udl_list.setCurrentRow(
                0
            )

        else:
            initial_udl = (
                UDLLocator.find_initial()
            )

            if initial_udl:
                for index in range(
                    self.udl_list.count()
                ):
                    item = (
                        self.udl_list.item(
                            index
                        )
                    )

                    path = item.data(
                        Qt.ItemDataRole.UserRole
                    )

                    if (
                        str(path).lower()
                        == str(initial_udl).lower()
                    ):
                        self.udl_list.setCurrentRow(
                            index
                        )
                        break

        if self.udl_list.count() == 0:
            self._set_status(
                "Status: No UDL files found",
                "error",
            )

    # ============================================================
    # LOCAL SELECTION
    # ============================================================

    def _selection_changed(self) -> None:
        item = self.udl_list.currentItem()

        if item is None:
            self._clear_details()
            return

        udl_path = item.data(
            Qt.ItemDataRole.UserRole
        )

        if not udl_path:
            self._clear_details()
            return

        self._show_udl_details(
            str(udl_path)
        )

    def _show_udl_details(
        self,
        udl_path: str,
    ) -> None:
        self.test_button.setEnabled(
            True
        )

        self.connect_button.setEnabled(
            True
        )

        self.udl_value.setText(
            f"UDL file: {udl_path}"
        )

        try:
            connection = DatabaseConnection(
                udl_path
            )

            self.server_value.setText(
                "Server: "
                + (
                    connection.server_name()
                    or "-"
                )
            )

            self.database_value.setText(
                "Database: "
                + (
                    connection.database_name()
                    or "-"
                )
            )

            self._set_status(
                "Status: Not tested",
                "default",
            )

        except Exception as exc:
            self.server_value.setText(
                "Server: -"
            )

            self.database_value.setText(
                "Database: -"
            )

            self._set_status(
                f"Status: Invalid UDL - {exc}",
                "error",
            )

    def _clear_details(self) -> None:
        self.udl_value.setText(
            "UDL file: -"
        )

        self.server_value.setText(
            "Server: -"
        )

        self.database_value.setText(
            "Database: -"
        )

        self._set_status(
            "Status: Not selected",
            "default",
        )

        self.test_button.setEnabled(
            False
        )

        self.connect_button.setEnabled(
            False
        )

    # ============================================================
    # LOCAL BROWSE
    # ============================================================

    def _browse_udl(self) -> None:
        last_folder = str(
            self._settings.value(
                self.LAST_FOLDER_KEY,
                "",
            )
            or ""
        )

        if not last_folder:
            last_folder = str(
                Path.home()
            )

        if not Path(last_folder).exists():
            last_folder = str(
                Path.home()
            )

        file_path, _ = (
            QFileDialog.getOpenFileName(
                self,
                "Select UDL File",
                last_folder,
                "UDL files (*.udl);;All files (*.*)",
            )
        )

        if not file_path:
            return

        selected_path = Path(
            file_path
        ).resolve()

        self._save_last_folder(
            selected_path.parent
        )

        self._add_or_select_udl(
            selected_path
        )

    def _add_or_select_udl(
        self,
        udl_path: Path,
    ) -> None:
        target = str(
            udl_path.resolve()
        ).lower()

        for index in range(
            self.udl_list.count()
        ):
            item = self.udl_list.item(
                index
            )

            path = item.data(
                Qt.ItemDataRole.UserRole
            )

            if (
                str(path).lower()
                == target
            ):
                self.udl_list.setCurrentRow(
                    index
                )
                return

        item = QListWidgetItem(
            udl_path.name
        )

        item.setData(
            Qt.ItemDataRole.UserRole,
            str(udl_path),
        )

        item.setToolTip(
            str(udl_path)
        )

        self.udl_list.addItem(
            item
        )

        self.udl_list.setCurrentItem(
            item
        )

    # ============================================================
    # LOCAL TEST
    # ============================================================

    def _test_connection(self) -> None:
        udl_path = self._selected_udl()

        if not udl_path:
            return

        self._set_status(
            "Status: Testing connection...",
            "testing",
        )

        try:
            connection = DatabaseConnection(
                udl_path
            )

            sql_connection = (
                connection.connect()
            )

            try:
                sql_connection.close()
            except Exception:
                pass

            self.server_name = (
                connection.server_name()
            )

            self.database_name = (
                connection.database_name()
            )

            self._set_status(
                "Status: Connection successful",
                "success",
            )

        except Exception as exc:
            self._set_status(
                "Status: Connection failed",
                "error",
            )

            QMessageBox.critical(
                self,
                "Connection Failed",
                "The database connection could not "
                "be established.\n\n"
                f"UDL:\n{udl_path}\n\n"
                f"Error:\n{exc}",
            )

    # ============================================================
    # REMOTE FIELDS
    # ============================================================

    def _remote_fields_changed(
        self,
        value: str = "",
    ) -> None:
        del value

        if self.connection_type != "remote":
            return

        required = (
            self.store_name_edit.text().strip()
            and self.server_edit.text().strip()
            and self.database_edit.text().strip()
            and self.username_edit.text().strip()
            and self.password_edit.text()
        )

        self.remote_test_button.setEnabled(
            bool(required)
        )

        self.connect_button.setEnabled(
            bool(required)
        )

    def _test_remote_connection(self) -> bool:
        server = (
            self.server_edit.text().strip()
        )

        database = (
            self.database_edit.text().strip()
        )

        username = (
            self.username_edit.text().strip()
        )

        password = (
            self.password_edit.text()
        )

        if not all(
            [
                server,
                database,
                username,
                password,
            ]
        ):
            QMessageBox.warning(
                self,
                "Missing Information",
                "Please enter Server, Database, "
                "Username and Password.",
            )

            return False

        self.remote_status.setText(
            "Status: Testing connection..."
        )

        try:
            connection = (
                DatabaseConnection.from_remote(
                    server=server,
                    database=database,
                    username=username,
                    password=password,
                    driver="ODBC Driver 17 for SQL Server",
                    encrypt=False,
                    trust_server_certificate=True,
                )
            )

            sql_connection = (
                connection.connect()
            )

            try:
                cursor = (
                    sql_connection.cursor()
                )

                cursor.execute(
                    "SELECT @@SERVERNAME, DB_NAME()"
                )

                row = cursor.fetchone()

                cursor.close()

            finally:
                sql_connection.close()

            self.server_name = (
                connection.server_name()
            )

            self.database_name = (
                connection.database_name()
            )

            self.remote_status.setText(
                "Status: Connection successful "
                f"({row[0]} / {row[1]})"
            )

            self.remote_status.setStyleSheet(
                """
                QLabel#detailLabel {
                    color: #16803A;
                    background: #ECF9F0;
                    border: 1px solid #A9DFB9;
                    font-weight: 700;
                    padding: 6px;
                    border-radius: 5px;
                }
                """
            )

            return True

        except Exception as exc:
            self.remote_status.setText(
                "Status: Connection failed"
            )

            self.remote_status.setStyleSheet(
                """
                QLabel#detailLabel {
                    color: #C62828;
                    background: #FFF1F1;
                    border: 1px solid #F0B8B8;
                    font-weight: 700;
                    padding: 6px;
                    border-radius: 5px;
                }
                """
            )

            QMessageBox.critical(
                self,
                "Connection Failed",
                "The remote SQL connection could not "
                "be established.\n\n"
                f"Server:\n{server}\n\n"
                f"Database:\n{database}\n\n"
                f"Error:\n{exc}",
            )

            return False

