    def _connection_mode_changed(
        self,
        index: int = -1,
    ) -> None:
        del index

        mode = self.connection_mode.currentData()

        self.connection_type = (
            str(mode or "udl")
        )

        is_remote = (
            self.connection_type == "remote"
        )

        self.local_card.setVisible(
            not is_remote
        )

        self.local_details_card.setVisible(
            not is_remote
        )

        self.remote_card.setVisible(
            is_remote
        )

        if is_remote:
            self._remote_fields_changed()
        else:
            self.connect_button.setEnabled(
                self._selected_udl() is not None
            )

