    def _connect_selected(
        self,
        checked: bool = False,
    ) -> None:
        del checked

        if self.connection_type == "remote":
            self._connect_remote()
            return

        self._connect_udl()

    def _connect_udl(self) -> None:
        udl_path = self._selected_udl()

        if not udl_path:
            return

        self._set_status(
            "Status: Connecting...",
            "testing",
        )

        try:
            connection = DatabaseConnection(
                udl_path
            )

            sql_connection = (
                connection.connect()
            )

            try:
                sql_connection.close()
            except Exception:
                pass

            self.selected_udl = (
                udl_path
            )

            self.remote_connection = None

            self.database_name = (
                connection.database_name()
            )

            self.server_name = (
                connection.server_name()
            )

            self._save_last_selection(
                udl_path
            )

            self._set_status(
                "Status: Connected",
                "success",
            )

            self.accept()

        except Exception as exc:
            self._set_status(
                "Status: Connection failed",
                "error",
            )

            QMessageBox.critical(
                self,
                "Connection Failed",
                "The database connection could not "
                "be established.\n\n"
                f"UDL:\n{udl_path}\n\n"
                f"Error:\n{exc}",
            )

    # ============================================================
    # REMOTE / CLIENT MODE
    # ============================================================

    def _connection_mode_changed(
        self,
        index: int = -1,
    ) -> None:
        del index

        mode = self.connection_mode.currentData()

        self.connection_type = str(mode or "udl")

        is_remote = self.connection_type == "remote"

        self.local_card.setVisible(not is_remote)
        self.local_details_card.setVisible(not is_remote)
        self.remote_card.setVisible(is_remote)

        if is_remote:
            self._remote_fields_changed()
        else:
            self.connect_button.setEnabled(
                self._selected_udl() is not None
            )


    def _remote_fields_changed(self) -> None:
        enabled = bool(
            getattr(self, "remote_udl_path", None)
            and Path(self.remote_udl_path).is_file()
        )

        if hasattr(self, "remote_test_button"):
            self.remote_test_button.setEnabled(enabled)

        if hasattr(self, "connect_button"):
            self.connect_button.setEnabled(enabled)


    def _test_remote_connection(self) -> bool:
        udl_path = getattr(
            self,
            "remote_udl_path",
            None,
        )

        if not udl_path:
            self.remote_status.setText(
                "Status: Select a UDL file first."
            )

            self.connect_button.setEnabled(False)

            return False

        self.remote_status.setText(
            "Status: Testing connection..."
        )

        try:
            connection = DatabaseConnection(
                udl_path
            )

            with connection.connect() as conn:
                cursor = conn.cursor()
                cursor.execute("SELECT 1")
                cursor.fetchone()

            self.remote_connection = connection

            self.remote_status.setText(
                "Status: Connection successful"
            )

            self.connect_button.setEnabled(True)

            self._set_status(
                "Remote / Client connection successful.",
                "success",
            )

            return True

        except Exception as exc:
            self.remote_status.setText(
                "Status: Connection failed"
            )

            self.connect_button.setEnabled(False)

            self._set_status(
                "Remote / Client connection failed.",
                "error",
            )

            QMessageBox.critical(
                self,
                "Connection Failed",
                (
                    "Could not connect using the selected UDL."
                    f"\n\nError:\n{exc}"
                ),
            )

            return False

    def _connect_remote(self) -> None:
        udl_path = getattr(
            self,
            "remote_udl_path",
            None,
        )

        if not udl_path:
            QMessageBox.warning(
                self,
                "Remote / Client",
                "Please select a UDL file first.",
            )
            return

        if not self._test_remote_connection():
            return

        try:
            connection = DatabaseConnection(
                udl_path
            )

            self.selected_udl = udl_path
            self.remote_connection = connection

            self.database_name = (
                connection.database_name()
            )

            self.server_name = (
                connection.server_name()
            )

            self._set_status(
                "Remote / Client connection successful.",
                "success",
            )

            self.accept()

        except Exception as exc:
            self._set_status(
                "Status: Connection failed",
                "error",
            )

            QMessageBox.critical(
                self,
                "Connection Failed",
                (
                    "Could not activate the selected UDL."
                    f"\n\nError:\n{exc}"
                ),
            )


    def _get_last_folder(self) -> Path:
        last_folder = str(
            self._settings.value(
                self.LAST_FOLDER_KEY,
                "",
            )
            or ""
        )

        if last_folder:
            folder = Path(last_folder).expanduser()
            if folder.exists() and folder.is_dir():
                return folder

        return Path.home()

    def _save_last_folder(
        self,
        folder: Path,
    ) -> None:
        self._settings.setValue(
            self.LAST_FOLDER_KEY,
            str(folder.resolve()),
        )

        self._settings.sync()

    def _save_last_selection(
        self,
        udl_path: str,
    ) -> None:
        path = Path(
            udl_path
        ).resolve()

        self._settings.setValue(
            self.LAST_UDL_KEY,
            str(path),
        )

        self._settings.setValue(
            self.LAST_FOLDER_KEY,
            str(path.parent),
        )

        self._settings.sync()

    def _selected_udl(self) -> str | None:
        item = self.udl_list.currentItem()

        if item is None:
            return None

        path = item.data(
            Qt.ItemDataRole.UserRole
        )

        if not path:
            return None

        return str(path)

