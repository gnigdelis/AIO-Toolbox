    def _browse_remote_udl(self) -> None:
        start_folder = self._get_last_folder()

        file_path, _ = QFileDialog.getOpenFileName(
            self,
            "Select Remote / Client UDL",
            str(start_folder),
            "UDL files (*.udl);;All files (*.*)",
        )

        if not file_path:
            return

        selected_path = Path(
            file_path
        ).resolve()

        self._save_last_folder(
            selected_path.parent
        )

        self._load_remote_udl(
            selected_path
        )


    def _load_remote_udl(self, udl_path: str) -> None:
        try:
            connection = DatabaseConnection(udl_path)

            self.remote_udl_path = udl_path
            self.remote_connection = connection

            self.remote_udl_edit.setText(udl_path)

            self.remote_server_value.setText(
                connection.server_name() or "-"
            )

            self.remote_database_value.setText(
                connection.database_name() or "-"
            )

            username = "-"

            try:
                connection_string = (
                    connection.reader.get_connection_string()
                )

                match = re.search(
                    r"(?:User ID|UID)\s*=\s*([^;]+)",
                    connection_string,
                    re.IGNORECASE,
                )

                if match:
                    username = match.group(1).strip()

            except Exception:
                pass

            self.remote_username_value.setText(username)

            self.database_name = connection.database_name()
            self.server_name = connection.server_name()

            self.remote_status.setText(
                "Status: UDL loaded. Ready to test."
            )

            self.remote_test_button.setEnabled(True)
            self.connect_button.setEnabled(True)

            self._set_status(
                "Remote / Client UDL selected.",
                "success",
            )

        except Exception as exc:
            self.remote_udl_path = None
            self.remote_connection = None

            self.remote_udl_edit.clear()
            self.remote_server_value.setText("-")
            self.remote_database_value.setText("-")
            self.remote_username_value.setText("-")

            self.remote_test_button.setEnabled(False)
            self.connect_button.setEnabled(False)

            self.remote_status.setText(
                "Status: Invalid UDL"
            )

            QMessageBox.critical(
                self,
                "Invalid UDL",
                (
                    "Could not read the selected UDL file."
                    f"\n\nError:\n{exc}"
                ),
            )

